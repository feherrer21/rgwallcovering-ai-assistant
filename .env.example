# Copia este fichero a .env y rellena la clave.
# .env está en .gitignore: nunca se commitea.

ANTHROPIC_API_KEY=sk-ant-...

# --- Opcionales (los valores por defecto están en agent_core/config.py) ---

# MODEL=claude-opus-5
# EFFORT=low                      # low | medium | high | xhigh | max
# MAX_TOKENS=8000

# Piso de relevancia. PROVISIONAL: se calibra en la fase 6.
# RELEVANCE_FLOOR=0.62
# TOP_K=5
# MAX_POR_FUENTE=2

# --- Entrega de leads por correo -----------------------------------------
#
# Sin estas credenciales el asistente funciona igual y el lead se guarda en
# data/leads.jsonl; lo único que no ocurre es que le llegue a Ronald.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-cuenta@gmail.com

# Contraseña de APLICACIÓN de Google (16 caracteres, sin espacios), NO la
# contraseña de tu cuenta. Se genera en myaccount.google.com/apppasswords y
# requiere tener la verificación en dos pasos activada.
SMTP_PASSWORD=

# MIENTRAS DESARROLLAS: pon aquí TU correo, no el de Ronald. Un lead de
# prueba en su bandeja es una llamada perdida a una persona que no existe.
# Acepta lista separada por comas: Ronald adelantó que más adelante querrá
# añadir una o dos direcciones más.
LEAD_EMAIL_TO=tu-correo@ejemplo.com

# Remitente. Si se deja vacío se usa SMTP_USER.
# LEAD_EMAIL_FROM=

# --- API ------------------------------------------------------------------

# En producción, restringir al dominio del cliente:
# ALLOWED_ORIGINS=https://rgwallcovering.com

# Límite por IP en POST /chat. Cada turno es una llamada al modelo que paga
# Ronald; sin tope, el endpoint es una factura abierta contra él.
# RATE_LIMIT_POR_MINUTO=10
# RATE_LIMIT_POR_HORA=60

# GET /leads devuelve datos personales. Sin esta variable el endpoint responde
# 503 y no existe para nadie, que es como debe desplegarse: el sistema de
# registro es la bandeja de Ronald, no este endpoint. Ponerlo solo si de
# verdad hace falta mirar los leads por HTTP.
# ADMIN_TOKEN=
